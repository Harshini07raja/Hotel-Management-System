# ==============================================================================
# Scalable Hotel Management System - Environment Variables
# ==============================================================================

# Server Configuration
SERVER_PORT=8088
SPRING_PROFILES_ACTIVE=dev

# MongoDB Sharded Database Connection
# In local development mode, multiple independent shard databases run on port 27017:
# (hotel_shard_0, hotel_shard_1, hotel_shard_2, and dynamically expandable shards)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/hotel_shard_0
APP_SHARDING_BASE_URI=mongodb://localhost:27017
APP_SHARDING_DEFAULT_SHARDS=hotel_shard_0,hotel_shard_1,hotel_shard_2

# Redis Key-Value Store Configuration
# If Redis is unavailable, the application automatically falls back to an in-memory ConcurrentHashMap
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# JWT Authentication Secrets
# Provide a strong 256-bit or 512-bit secret key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Distributed ID Generator (Snowflake)
# Node ID should be unique per running application instance (0 - 1023)
SNOWFLAKE_NODE_ID=1

# Rate Limiter Configuration (Token Bucket)
RATE_LIMITER_CAPACITY=100
RATE_LIMITER_REFILL_RATE=50.0

# Base URL for Shortened Booking Links
APP_SHORT_URL_BASE=http://localhost:8088/s/

# Frontend Configuration (for React / Vite)
VITE_API_BASE_URL=http://localhost:8088/api/v1
